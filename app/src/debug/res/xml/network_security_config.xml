<?xml version="1.0" encoding="utf-8"?>
<!-- Solo para pruebas (debug): permite hablar con el servidor de la PC en la red local sin HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
