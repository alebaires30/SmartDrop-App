<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Gotita: dictado por voz y "Oye Gotita" (solo con la app abierta; se pide al usarlo). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Para que la app pueda usar el reconocimiento de voz y la voz del teléfono. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartDrop"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        tools:targetApi="31">
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
        <activity
            android:name=".RecomendacionesActivity"
            android:exported="false" />
        <activity
            android:name=".AlertasActivity"
            android:exported="false" />
        <activity
            android:name=".PrediccionSuministroActivity"
            android:exported="false" />
        <activity
            android:name=".ZonaPrediccionDetalleActivity"
            android:exported="false" />
        <activity
            android:name=".PrediccionFugasActivity"
            android:exported="false" />
        <activity
            android:name=".RetroalimentacionActivity"
            android:exported="false" />
        <activity
            android:name=".ConsumoActivity"
            android:exported="false" />
        <activity
            android:name=".VincularViviendaActivity"
            android:exported="false" />
        <activity
            android:name=".GraficasMonitoreoActivity"
            android:exported="false" />
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".PresionActivity"
            android:exported="false" />
        <activity
            android:name=".CalidadActivity"
            android:exported="false" />
        <activity
            android:name=".NivelTanqueActivity"
            android:exported="false" />
        <activity
            android:name=".InicioActivity"
            android:exported="false" /> <!-- Registro -->
        <activity android:name=".RegisterActivity" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ValvulaActivity"
            android:exported="false" />
        <activity
            android:name=".BusquedaActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".ReportarProblemaActivity"
            android:exported="false" />
        <activity
            android:name=".ComunidadActivity"
            android:exported="false" />
        <activity
            android:name=".ReporteDetalleActivity"
            android:exported="false" />
        <activity
            android:name=".PerfilActivity"
            android:exported="false" />
        <activity
            android:name=".ConfiguracionActivity"
            android:exported="false" />
    </application>

</manifest>
