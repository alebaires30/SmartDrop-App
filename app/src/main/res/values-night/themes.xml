<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema nocturno: se llama igual que en values/themes.xml para que AppCompat lo aplique
         solo en modo noche. Todo el mapeo vive en Base.Theme.SmartDrop (values/themes.xml) y los
         colores cambian por values-night/colors.xml; aquí solo cambian las barras del sistema. -->
    <style name="Theme.SmartDrop" parent="Base.Theme.SmartDrop">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
