<?xml version="1.0" encoding="utf-8"?>
<!-- Fuentes que Google Play Services descarga por adelantado (meta-data "preloaded_fonts" del manifest). -->
<resources>
    <array name="preloaded_fonts" translatable="false">
        <item>@font/inter_regular</item>
        <item>@font/inter_medium</item>
        <item>@font/inter_semibold</item>
        <item>@font/inter_bold</item>
        <item>@font/montserrat_semibold</item>
        <item>@font/montserrat_bold</item>
    </array>
</resources>
