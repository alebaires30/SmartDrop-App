<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartDrop · sistema de diseño "Agua en casa", tema agua (modo claro): mismos valores que la web.
    Los tokens tienen los mismos nombres que en la web (spec §3, en snake_case) y se
    redefinen con valores oscuros en values-night/colors.xml.
    Debajo están los nombres antiguos: siguen existiendo porque layouts y Java los usan,
    pero ahora apuntan a un token (no tienen valores propios; el modo oscuro los sigue solo).
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ============ Tokens: superficies ============ -->
    <color name="page">#F1F8FD</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_2">#F5FAFE</color>
    <color name="surface_tint">#E3F2FB</color>
    <color name="line">#D6E7F2</color>
    <color name="line_strong">#AECDE2</color>

    <!-- ============ Tokens: texto ============ -->
    <color name="ink">#0B2A42</color>
    <color name="ink_2">#3A5870</color>
    <color name="ink_3">#52708A</color>

    <!-- ============ Tokens: marca (azul océano; el nombre "añil" se conserva) ============ -->
    <color name="anil">#0369A1</color>
    <color name="anil_strong">#075985</color>
    <color name="anil_soft">#E0F2FE</color>
    <color name="on_anil">#FFFFFF</color>

    <!-- ============ Tokens: agua y luz cálida ============ -->
    <color name="agua">#0891D1</color>
    <color name="agua_soft">#DDF2FC</color>
    <!-- sol: solo ilustración / hero. Nunca texto, nunca estado. -->
    <color name="sol">#F2B544</color>
    <color name="sol_soft">#FDF3DE</color>

    <!-- ============ Tokens: estados (texto/icono · fondo de pill · punto) ============ -->
    <color name="ok">#1E7A50</color>
    <color name="ok_bg">#E1F3E9</color>
    <color name="ok_dot">#2E9E68</color>
    <color name="warn">#8A5300</color>
    <color name="warn_bg">#FDF0D6</color>
    <color name="warn_dot">#D98A00</color>
    <color name="bad">#B42318</color>
    <color name="bad_bg">#FDE6E3</color>
    <color name="bad_dot">#D92D20</color>
    <color name="none">#5F6985</color>
    <color name="none_bg">#ECEEF4</color>

    <!-- ============ Roles inversos (Snackbar y similares) ============ -->
    <color name="inverse_surface">#0B2A42</color>
    <color name="inverse_on_surface">#E6F3FC</color>
    <color name="inverse_primary">#7DD3FC</color>

    <!-- ===================================================================
         Nombres antiguos → tokens. Elegidos según cómo se usan hoy
         (texto vs fondo) para mantener ≥ 4.5:1 en texto.
         =================================================================== -->

    <!-- Fondos -->
    <color name="bg_app">@color/page</color>
    <color name="bg_card">@color/surface</color>
    <color name="bg_card_alt">@color/surface_2</color>
    <!-- bg_purple_soft también se usa como texto sobre añil (burbuja de chat propia) -->
    <color name="bg_purple_soft">@color/anil_soft</color>
    <color name="bg_alert">@color/bad_bg</color>
    <color name="bg_warning">@color/warn_bg</color>
    <color name="bg_input">@color/surface_2</color>
    <color name="bg_search">@color/surface_2</color>
    <color name="bg_info_soft">@color/agua_soft</color>
    <!-- bg_lavender: fondo de la opción seleccionada (ReportarProblemaActivity) -->
    <color name="bg_lavender">@color/anil_soft</color>
    <color name="bg_lavender_end">@color/surface_tint</color>
    <color name="bg_lavender_alt">@color/surface_tint</color>
    <color name="bg_chip">@color/surface_tint</color>
    <color name="bg_circle_soft">@color/anil_soft</color>
    <color name="btn_secondary_bg">@color/surface_tint</color>

    <!-- Textos -->
    <color name="text_primary">@color/ink</color>
    <color name="text_secondary">@color/ink_2</color>
    <color name="text_muted">@color/ink_3</color>
    <color name="text_hint">@color/ink_3</color>

    <!-- Marca -->
    <color name="brand_primary">@color/anil</color>
    <color name="brand_accent">@color/anil</color>
    <color name="brand_on_card">@color/anil</color>
    <color name="brand_soft">@color/anil_soft</color>
    <!-- brand_blue solo se usa en barras de progreso y series de gráfica (no texto) -->
    <color name="brand_blue">@color/agua</color>
    <color name="on_brand">@color/on_anil</color>
    <color name="nav_bar">@color/surface</color>

    <!-- Bordes / strokes -->
    <color name="stroke_soft">@color/line</color>
    <color name="stroke_input">@color/line_strong</color>
    <color name="stroke_search">@color/line_strong</color>
    <color name="stroke_lavender">@color/line_strong</color>

    <!-- Estados. Java los usa casi siempre como color de TEXTO (estado de válvula,
         nivel de riesgo, estado de reporte), por eso apuntan a ok/warn/bad y no a
         los *_dot, que no llegan a 4.5:1 sobre blanco. -->
    <color name="success">@color/ok</color>
    <color name="success_dark">@color/ok</color>
    <color name="danger">@color/bad</color>
    <color name="text_alert">@color/bad</color>
    <color name="warning_text">@color/warn</color>
    <color name="status_orange">@color/warn</color>
    <color name="status_yellow">@color/warn</color>
    <color name="status_green">@color/ok</color>
    <color name="status_blue">@color/anil</color>
    <color name="status_amber">@color/warn</color>
    <!-- star_yellow pinta estrellas de 42sp (texto): sol no llega a 3:1, warn sí -->
    <color name="star_yellow">@color/warn</color>

    <!-- ============ Tema agua (igual que la web): escenas, olas, burbujas y cristal ============ -->
    <color name="agua_grad_inicio">#EAF7FE</color>
    <color name="agua_grad_medio">#D6EEFA</color>
    <color name="agua_grad_fin">#C2E6F6</color>
    <color name="agua_claro">#7DD3FC</color>
    <color name="agua_boton_inicio">#0377B5</color>
    <color name="agua_boton_fin">#075985</color>
    <color name="ola_1">#8CFFFFFF</color>
    <color name="ola_2">#260EA5E9</color>
    <color name="burbuja">#D9FFFFFF</color>
    <color name="cristal">#C7FFFFFF</color>
    <color name="cristal_borde">#F2FFFFFF</color>

    <!-- Casa detallada (casa_detallada.xml): colores de la ilustración -->
    <color name="casa_pared">#FFFFFF</color>
    <color name="casa_pared_sombra">#E3EEF6</color>
    <color name="casa_techo">#0369A1</color>
    <color name="casa_techo_sombra">#075985</color>
    <color name="casa_trazo">#0B2A42</color>
    <color name="casa_ventana">#BAE6FD</color>
    <color name="casa_puerta">#B7794A</color>
    <color name="casa_puerta_sombra">#8F5A33</color>
    <color name="casa_cesped">#86CFA0</color>
    <color name="casa_cesped_oscuro">#4FA874</color>
    <color name="casa_arbusto">#3E9B6A</color>
    <color name="casa_arbusto_claro">#6CC28F</color>
    <color name="casa_tronco">#8F5A33</color>
    <color name="casa_flor_1">#F472B6</color>
    <color name="casa_flor_2">#F2B544</color>
    <color name="casa_camino">#D6E2EA</color>
    <color name="casa_luz">#F2B544</color>
    <!-- Nubes de la escena del login -->
    <color name="nube">#F2FFFFFF</color>
</resources>
