<?xml version="1.0" encoding="utf-8"?>
<!-- Progreso de "Realizar predicciones" (PrediccionRunner): paso actual y barra determinada. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_6">

    <ImageView
        android:importantForAccessibility="no"
        android:id="@+id/ivGota"
        style="@style/Widget.SmartDrop.IconChip.Agua"
        android:layout_width="@dimen/icon_chip_lg"
        android:layout_height="@dimen/icon_chip_lg"
        android:src="@drawable/ic_drop" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:accessibilityHeading="true"
        android:text="Calculando predicciones…"
        android:textAppearance="@style/TextAppearance.SmartDrop.Title"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/tvPasoPrediccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:text="Iniciando"
        android:textAppearance="@style/TextAppearance.SmartDrop.Body"
        android:textColor="@color/ink_2" />

    <ProgressBar
        android:id="@+id/progresoPrediccion"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="@dimen/space_5"
        android:contentDescription="Progreso de las predicciones"
        android:max="100"
        android:progressDrawable="@drawable/meter_progress" />

    <TextView
        android:id="@+id/tvPorcentajePrediccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="0 %"
        android:textAppearance="@style/TextAppearance.SmartDrop.Label"
        android:textColor="@color/ink_2" />
</LinearLayout>
