<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de carga de "Realizar predicciones": solo aparece si el análisis tarda. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivGota"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_water_drop"
        android:contentDescription="Analizando" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Realizando predicciones…"
        android:textColor="@color/brand_on_card"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPasoPrediccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:minHeight="40dp"
        android:text="Iniciando"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/progresoPrediccion"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progressTint="@color/brand_accent" />

    <TextView
        android:id="@+id/tvPorcentajePrediccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0 %"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>