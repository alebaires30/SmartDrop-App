<?xml version="1.0" encoding="utf-8"?>
<!-- Predicción de fugas (administración): estado del monitor automático, avisos sin leer y
     viviendas con su probabilidad de fuga. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    tools:context=".PrediccionFugasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="Predicción de fugas"
            android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
            android:textColor="@color/ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <TextView
        android:id="@+id/tvEstadoMonitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/gutter"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_status_info"
        android:drawablePadding="@dimen/space_3"
        android:gravity="center_vertical"
        android:padding="@dimen/space_4"
        android:text="Consultando el monitor automático…"
        android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall"
        app:drawableStartCompat="@drawable/ic_activity"
        app:drawableTint="@color/anil" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="@dimen/space_3"
        android:layout_marginEnd="@dimen/space_2"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAvisosSinLeer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarcarLeidos"
            style="@style/Widget.SmartDrop.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marcar como leídos"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFugas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/space_3"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_7" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/tvSinDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_7"
        android:text="Aún no hay viviendas analizadas. Usa Realizar predicciones en Predicción de suministro."
        android:textAppearance="@style/TextAppearance.SmartDrop.Body"
        android:textColor="@color/ink_2"
        android:visibility="gone" />
</LinearLayout>
