<?xml version="1.0" encoding="utf-8"?>
<!-- Gráficas y monitoreo (administración): parámetro (pestañas), periodo (chips), aviso de valores
     fuera de rango, gráfica con su resumen y comparación de los tres parámetros. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    tools:context=".GraficasMonitoreoActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/space_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/space_2"
            android:accessibilityHeading="true"
            android:text="Gráficas y monitoreo"
            android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
            android:textColor="@color/ink" />
    </com.google.android.material.appbar.MaterialToolbar>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabParametros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:tabIndicatorColor="@color/anil"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/anil"
        app:tabTextAppearance="@style/TextAppearance.SmartDrop.Label"
        app:tabTextColor="@color/ink_2">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flujo" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presión" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nivel" />
    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_8">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPeriodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHoy"
                    style="@style/Widget.SmartDrop.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="Hoy" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSemana"
                    style="@style/Widget.SmartDrop.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Semana" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMes"
                    style="@style/Widget.SmartDrop.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Mes" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlertaRango"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bad_bg"
                app:strokeColor="@color/bad_dot">

                <TextView
                    android:id="@+id/tvAlertaRango"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="assertive"
                    android:drawablePadding="@dimen/space_3"
                    android:gravity="center_vertical"
                    android:text="Hay valores fuera de rango en este periodo"
                    android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong"
                    android:textColor="@color/bad"
                    app:drawableStartCompat="@drawable/ic_alert_circle"
                    app:drawableTint="@color/bad" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvTituloGrafica"
                style="@style/Widget.SmartDrop.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="Flujo de agua (L/min)" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="260dp">

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Gráfica del parámetro seleccionado" />

                        <LinearLayout
                            android:id="@+id/layoutCargando"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/surface"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <ProgressBar
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:indeterminateTint="@color/anil" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="Recopilando datos…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong"
                                android:textColor="@color/ink" />

                            <TextView
                                android:id="@+id/tvCargandoDetalle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="Esto puede tardar unos segundos"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvResumenGrafica"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvUltimaActualizacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:drawablePadding="@dimen/space_1"
                android:gravity="center_vertical"
                android:text="Última actualización: --:--"
                android:textAppearance="@style/TextAppearance.SmartDrop.Caption"
                app:drawableStartCompat="@drawable/ic_clock"
                app:drawableTint="@color/ink_3" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Comparar parámetros"
                            android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Muestra flujo, presión y nivel en la misma gráfica."
                            android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchComparar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:contentDescription="Comparar flujo, presión y nivel"
                        android:minHeight="@dimen/touch_min"
                        app:thumbTint="@color/sd_switch_m2_thumb"
                        app:trackTint="@color/sd_switch_m2_track"
                        app:useMaterialThemeColors="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
