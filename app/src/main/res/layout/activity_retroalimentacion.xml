<?xml version="1.0" encoding="utf-8"?>
<!-- Tu consumo (retroalimentación): el mensaje humano primero, luego el consumo de hoy con su
     escala y la comparación del mes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    tools:context=".RetroalimentacionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="Tu consumo"
            android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
            android:textColor="@color/ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_7">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmartDrop.Card.Warm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMensaje"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:accessibilityLiveRegion="polite"
                        android:text="Cargando…"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Title"
                        android:textColor="@color/ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_5"
                        android:text="Consumo registrado hoy"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                        android:textColor="@color/ink_2" />

                    <TextView
                        android:id="@+id/tvValorGota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 L"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Display" />

                    <ProgressBar
                        android:id="@+id/progressConsumo"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="@dimen/space_4"
                        android:contentDescription="Consumo de hoy frente a lo habitual"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/meter_progress" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Bajo"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Habitual"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Elevado"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/Widget.SmartDrop.IconChip.Anil"
                        android:layout_width="@dimen/icon_chip"
                        android:layout_height="@dimen/icon_chip"
                        android:src="@drawable/ic_calendar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Comparación mensual"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                            android:textColor="@color/ink_2" />

                        <TextView
                            android:id="@+id/tvComparacionMes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="Cargando…"
                            android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/Widget.SmartDrop.IconChip.Ok"
                        android:layout_width="@dimen/icon_chip"
                        android:layout_height="@dimen/icon_chip"
                        android:src="@drawable/ic_leaf" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tu racha de ahorro"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                            android:textColor="@color/ink_2" />

                        <TextView
                            android:id="@+id/tvRacha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="Cargando…"
                            android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavRetro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_consumo" />
</LinearLayout>
