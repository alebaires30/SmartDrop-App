<?xml version="1.0" encoding="utf-8"?>
<!-- Mi perfil: identidad en escena cálida, datos personales, avisos y preferencias (se guardan al
     instante) y cerrar sesión. Desliza hacia abajo para recargar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    tools:context=".PerfilActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:id="@+id/tvTituloPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="Mi perfil"
            android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
            android:textColor="@color/ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipePerfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_5"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="@dimen/space_8">

                <!-- Identidad -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SmartDrop.Card.Warm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPerfilIniciales"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_avatar"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Title"
                            android:textColor="@color/anil" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPerfilNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Title"
                                android:textColor="@color/ink" />

                            <TextView
                                android:id="@+id/tvPerfilEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text=""
                                android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

                            <TextView
                                android:id="@+id/tvPerfilRol"
                                style="@style/Widget.SmartDrop.StatusPill.Info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Información personal -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:accessibilityHeading="true"
                                android:text="Información personal"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                                android:textColor="@color/ink" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditarPerfil"
                                style="@style/Widget.SmartDrop.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Editar perfil" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutDatosPersonales"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Notificaciones -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="Notificaciones"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="Elige qué alertas ves en la web y en la app, y cuáles te avisan en el teléfono."
                            android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

                        <LinearLayout
                            android:id="@+id/layoutNotificaciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:divider="@drawable/divider_line"
                            android:orientation="vertical"
                            android:showDividers="middle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Preferencias -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="Preferencias"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="Se guardan al instante y también se aplican en la web."
                            android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

                        <LinearLayout
                            android:id="@+id/layoutPreferencias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:divider="@drawable/divider_line"
                            android:orientation="vertical"
                            android:showDividers="middle" />

                        <LinearLayout
                            android:id="@+id/layoutReporteSemanal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:background="@drawable/bg_status_info"
                            android:orientation="vertical"
                            android:padding="@dimen/space_4"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Último reporte semanal"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/anil" />

                            <TextView
                                android:id="@+id/tvReporteSemanal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text=""
                                android:textAppearance="@style/TextAppearance.SmartDrop.Body" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvEstadoPreferencias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:accessibilityLiveRegion="polite"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesionPerfil"
                    style="@style/Widget.SmartDrop.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="Cerrar sesión"
                    app:icon="@drawable/ic_logout" />

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
