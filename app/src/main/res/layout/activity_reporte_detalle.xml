<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle del reporte: estado, descripción, fotos/videos, respuesta del equipo y conversación. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    tools:context=".ReporteDetalleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:id="@+id/tvTituloDetalle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="Detalle del reporte"
            android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
            android:textColor="@color/ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_5">

            <TextView
                android:id="@+id/tvDetalleEstado"
                style="@style/Widget.SmartDrop.StatusPill.None"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvDetalleTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.SmartDrop.Headline"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tvDetalleUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:drawablePadding="@dimen/space_2"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall"
                app:drawableStartCompat="@drawable/ic_map_pin"
                app:drawableTint="@color/ink_3" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <TextView
                    android:id="@+id/tvDetalleDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SmartDrop.Body"
                    android:textColor="@color/ink" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutAdjuntos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdjuntarEvidencia"
                style="@style/Widget.SmartDrop.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="Agregar fotos o videos"
                app:icon="@drawable/ic_plus" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRespuesta"
                style="@style/Widget.SmartDrop.Card.Tint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/space_2"
                        android:gravity="center_vertical"
                        android:text="Respuesta del equipo"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                        android:textColor="@color/anil"
                        app:drawableStartCompat="@drawable/ic_shield"
                        app:drawableTint="@color/anil" />

                    <TextView
                        android:id="@+id/tvRespuestaAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Body"
                        android:textColor="@color/ink" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.SmartDrop.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="Conversación" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="Escribe aquí si necesitas dar más detalles al equipo."
                android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:minHeight="120dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_2">

        <EditText
            android:id="@+id/etMensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Escribe un mensaje…"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="@dimen/touch_min"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.SmartDrop.Body" />

        <ImageButton
            android:id="@+id/btnEnviarMensaje"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/btn_sesion"
            android:contentDescription="Enviar mensaje"
            android:src="@drawable/ic_send"
            app:tint="@color/on_anil" />
    </LinearLayout>
</LinearLayout>
