<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio del residente: la casa con su tinaco (momento firma), las cuatro lecturas como
     mosaicos, la válvula de la casa y accesos rápidos. Mismo patrón que el inicio web. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".InicioActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_1"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/space_1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Abrir menú"
                android:src="@drawable/ic_menu"
                app:tint="@color/ink" />

            <TextView
                android:id="@+id/tvTituloToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/space_2"
                android:accessibilityHeading="true"
                android:text="Inicio"
                android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
                android:textColor="@color/ink" />

            <ImageButton
                android:id="@+id/btnPerfil"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mi perfil"
                android:src="@drawable/ic_person"
                app:tint="@color/ink" />

            <ImageButton
                android:id="@+id/btnSearchInicio"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_search"
                app:tint="@color/ink" />

        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/line" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_5"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="@dimen/space_8">

                <!-- ── Resumen del agua de la vivienda, en una escena de agua (tema agua) ── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResumenGeneral"
                    style="@style/Widget.SmartDrop.Card.Agua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_7">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_agua">

                        <include
                            android:id="@+id/burbujasInicio"
                            layout="@layout/fondo_burbujas" />

                        <ImageView
                            android:id="@+id/olasInicio"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="-32dp"
                            android:layout_marginEnd="-32dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/olas_agua" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/space_6"
                            android:paddingTop="@dimen/space_6"
                            android:paddingEnd="@dimen/space_6"
                            android:paddingBottom="@dimen/space_9">

                            <TextView
                                android:id="@+id/tvSaludoInicio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pildora_cristal"
                                android:paddingStart="@dimen/space_3"
                                android:paddingTop="@dimen/space_1"
                                android:paddingEnd="@dimen/space_3"
                                android:paddingBottom="@dimen/space_1"
                                android:text="Hola"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/anil_strong" />

                            <TextView
                                android:id="@+id/tvResumenGeneral"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:accessibilityHeading="true"
                                android:accessibilityLiveRegion="polite"
                                android:text="Revisando el agua de tu casa…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Headline"
                                android:textColor="@color/ink" />

                            <!-- La casa (sin tanque) y, debajo, el nivel del tanque: la barra se llena hasta el nivel real -->
                            <LinearLayout
                                android:id="@+id/panelTanqueHero"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_5"
                                android:background="@drawable/bg_cristal"
                                android:orientation="vertical"
                                android:padding="@dimen/space_5">

                                <ImageView
                                    android:id="@+id/ivCasaInicio"
                                    android:layout_width="match_parent"
                                    android:layout_height="180dp"
                                    android:layout_marginBottom="@dimen/space_4"
                                    android:importantForAccessibility="no"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/casa_detallada" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tanque de tu casa"
                                    android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                    android:textColor="@color/ink_2" />

                                <TextView
                                    android:id="@+id/tvHeroTanque"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:accessibilityLiveRegion="polite"
                                    android:text="— %"
                                    android:textAppearance="@style/TextAppearance.SmartDrop.Number" />

                                <TextView
                                    android:id="@+id/tvHeroLitros"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cargando…"
                                    android:textAppearance="@style/TextAppearance.SmartDrop.Body"
                                    android:textColor="@color/ink_2" />

                                <ProgressBar
                                    android:id="@+id/progresoHeroTanque"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="12dp"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:importantForAccessibility="no"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/bg_progreso_agua" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Las cuatro lecturas ── -->
                <TextView
                    style="@style/Widget.SmartDrop.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu agua ahora" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:layout_marginBottom="@dimen/space_4"
                    android:text="Toca una lectura para ver su detalle."
                    android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPresion"
                        style="@style/Widget.SmartDrop.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:id="@+id/espacioIconPresion"
                                style="@style/Widget.SmartDrop.IconChip.Anil"
                                android:layout_width="@dimen/icon_chip"
                                android:layout_height="@dimen/icon_chip"
                                android:src="@drawable/ic_gauge" />

                            <TextView
                                android:id="@+id/tvPresionTitulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="Presión"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/ink_2" />

                            <TextView
                                android:id="@+id/tvPresionValor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:accessibilityLiveRegion="polite"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCalidad"
                        style="@style/Widget.SmartDrop.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:id="@+id/espacioIconCalidad"
                                style="@style/Widget.SmartDrop.IconChip.Agua"
                                android:layout_width="@dimen/icon_chip"
                                android:layout_height="@dimen/icon_chip"
                                android:src="@drawable/ic_drop" />

                            <TextView
                                android:id="@+id/tvCalidadTitulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="Calidad"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/ink_2" />

                            <TextView
                                android:id="@+id/tvCalidadValor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:accessibilityLiveRegion="polite"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNivel"
                        style="@style/Widget.SmartDrop.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:id="@+id/espacioIconNivel"
                                style="@style/Widget.SmartDrop.IconChip.Agua"
                                android:layout_width="@dimen/icon_chip"
                                android:layout_height="@dimen/icon_chip"
                                android:src="@drawable/ic_tank" />

                            <TextView
                                android:id="@+id/tvNivelTitulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="Tanque"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/ink_2" />

                            <TextView
                                android:id="@+id/tvNivelPorcentaje"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:accessibilityLiveRegion="polite"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Number.Small" />

                            <TextView
                                android:id="@+id/tvNivelLitros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardConsumo"
                        style="@style/Widget.SmartDrop.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:id="@+id/espacioIconConsumo"
                                style="@style/Widget.SmartDrop.IconChip.Anil"
                                android:layout_width="@dimen/icon_chip"
                                android:layout_height="@dimen/icon_chip"
                                android:src="@drawable/ic_chart" />

                            <TextView
                                android:id="@+id/tvConsumoTitulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="Consumo"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/ink_2" />

                            <TextView
                                android:id="@+id/tvConsumoLitros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:accessibilityLiveRegion="polite"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Number.Small" />

                            <TextView
                                android:id="@+id/tvConsumoPeriodo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hoy"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ── Válvula de la casa ── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardValvulaInicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:id="@+id/espacioIconValvulaInicio"
                            style="@style/Widget.SmartDrop.IconChip.Agua"
                            android:layout_width="@dimen/icon_chip"
                            android:layout_height="@dimen/icon_chip"
                            android:src="@drawable/ic_valve" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Suministro de tu casa"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/ink_2" />

                            <TextView
                                android:id="@+id/tvValvulaEstadoInicio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:accessibilityLiveRegion="polite"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong" />

                            <TextView
                                android:id="@+id/tvValvulaActualizacionInicio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="Actualizando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_3" />
                    </LinearLayout>

                    <!-- Tubería del tanque a la casa: el agua avanza si la válvula está abierta -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="@drawable/bg_icon_chip_agua"
                        android:importantForAccessibility="noHideDescendants"
                        android:paddingStart="@dimen/space_2"
                        android:paddingTop="@dimen/space_1"
                        android:paddingEnd="@dimen/space_2"
                        android:paddingBottom="22dp">

                        <ImageView
                            android:id="@+id/imgTuberia"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/tuberia_cerrada" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="@dimen/space_2"
                            android:layout_marginBottom="-16dp"
                            android:text="Tanque"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="@dimen/space_2"
                            android:layout_marginBottom="-16dp"
                            android:text="Tu casa"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                    </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Accesos rápidos ── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportarInicio"
                    style="@style/Widget.SmartDrop.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="Reportar un problema"
                    app:icon="@drawable/ic_reporte_vector" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConsejosInicio"
                    style="@style/Widget.SmartDrop.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="Ver consejos de ahorro"
                    app:icon="@drawable/ic_bulb" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_btn_nav" />

</androidx.drawerlayout.widget.DrawerLayout>
