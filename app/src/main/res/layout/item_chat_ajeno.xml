<?xml version="1.0" encoding="utf-8"?>
<!-- Mensaje de la otra persona en la conversación del reporte (a la izquierda). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_1"
    android:paddingTop="@dimen/space_1"
    android:paddingEnd="56dp"
    android:paddingBottom="@dimen/space_1">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_ajeno"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_2">

        <TextView
            android:id="@+id/tvChatAutor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SmartDrop.Caption"
            android:textColor="@color/ink_2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChatTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SmartDrop.Body"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/tvChatFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
    </LinearLayout>
</LinearLayout>
