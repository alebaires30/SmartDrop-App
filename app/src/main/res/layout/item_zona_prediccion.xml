<?xml version="1.0" encoding="utf-8"?>
<!-- Tanque en Predicción de suministro (ZonasPrediccionAdapter): nombre, riesgo (pastilla),
     nivel con barra, ubicación, fugas y predicción en palabras. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.SmartDrop.Card.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvZonaNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zona"
                android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tvZonaRiesgo"
                style="@style/Widget.SmartDrop.StatusPill.None"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvZonaNivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong" />

        <ProgressBar
            android:id="@+id/progresoZona"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/space_2"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressDrawable="@drawable/meter_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvZonaConsumo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

            <TextView
                android:id="@+id/tvZonaAnomalias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.SmartDrop.Label" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvZonaPrediccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.SmartDrop.Body"
            android:textColor="@color/ink" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
