<?xml version="1.0" encoding="utf-8"?>
<!-- Panel general de administración: lo que necesita atención primero, las lecturas de la red
     como mosaicos y la operación (electroválvula y reportes). Igual que el panel web. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".AdminDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:paddingEnd="@dimen/space_1"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/space_1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Abrir menú"
                android:src="@drawable/ic_menu"
                app:tint="@color/ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/space_2"
                android:accessibilityHeading="true"
                android:text="Panel general"
                android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
                android:textColor="@color/ink" />

            <ImageButton
                android:id="@+id/btnSearchAdmin"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_search"
                app:tint="@color/ink" />
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/line" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_5"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="@dimen/space_8">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="El estado de la red de agua y lo que necesita tu atención hoy."
                    android:textAppearance="@style/TextAppearance.SmartDrop.Body"
                    android:textColor="@color/ink_2" />

                <!-- Necesita atención (lo muestra AdminDashboardActivity cuando hay alertas) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlertaGeneral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    app:cardBackgroundColor="@color/bad_bg"
                    app:strokeColor="@color/bad_dot">

                    <TextView
                        android:id="@+id/tvAlertaGeneral"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="assertive"
                        android:drawablePadding="@dimen/space_3"
                        android:gravity="center_vertical"
                        android:text="Revisando sensores…"
                        android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong"
                        android:textColor="@color/bad"
                        app:drawableStartCompat="@drawable/ic_alert_circle"
                        app:drawableTint="@color/bad" />
                </com.google.android.material.card.MaterialCardView>

                <!-- La red ahora -->
                <TextView
                    style="@style/Widget.SmartDrop.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="La red ahora" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:layout_marginBottom="@dimen/space_4"
                    android:text="Toca una lectura para ver su gráfica."
                    android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFlujo"
                        style="@style/Widget.SmartDrop.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:id="@+id/espacioIconFlujo"
                                style="@style/Widget.SmartDrop.IconChip.Agua"
                                android:layout_width="@dimen/icon_chip"
                                android:layout_height="@dimen/icon_chip"
                                android:src="@drawable/ic_drop" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="Flujo de agua"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/ink_2" />

                            <TextView
                                android:id="@+id/tvFlujoValor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Number.Small" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPresion"
                        style="@style/Widget.SmartDrop.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:id="@+id/espacioIconPresionAdmin"
                                style="@style/Widget.SmartDrop.IconChip.Anil"
                                android:layout_width="@dimen/icon_chip"
                                android:layout_height="@dimen/icon_chip"
                                android:src="@drawable/ic_gauge" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="Presión de la red"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/ink_2" />

                            <TextView
                                android:id="@+id/tvPresionValorAdmin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Number.Small" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNivelAdmin"
                        style="@style/Widget.SmartDrop.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:id="@+id/espacioIconNivelAdmin"
                                style="@style/Widget.SmartDrop.IconChip.Agua"
                                android:layout_width="@dimen/icon_chip"
                                android:layout_height="@dimen/icon_chip"
                                android:src="@drawable/ic_tank" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="Nivel de tanque"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/ink_2" />

                            <TextView
                                android:id="@+id/tvNivelValorAdmin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Number.Small" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAlertasActivas"
                        style="@style/Widget.SmartDrop.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:id="@+id/espacioIconAlertas"
                                style="@style/Widget.SmartDrop.IconChip.Warn"
                                android:layout_width="@dimen/icon_chip"
                                android:layout_height="@dimen/icon_chip"
                                android:src="@drawable/ic_bell" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="Alertas activas"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/ink_2" />

                            <TextView
                                android:id="@+id/tvAlertasCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Number.Small" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Operación -->
                <TextView
                    style="@style/Widget.SmartDrop.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:layout_marginBottom="@dimen/space_4"
                    android:text="Operación" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardValvula"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:id="@+id/espacioIconValvula"
                            style="@style/Widget.SmartDrop.IconChip.Agua"
                            android:layout_width="@dimen/icon_chip"
                            android:layout_height="@dimen/icon_chip"
                            android:src="@drawable/ic_valve" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Electroválvula"
                                android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong"
                                android:textColor="@color/ink" />

                            <TextView
                                android:id="@+id/tvValvulaEstadoAdmin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:accessibilityLiveRegion="polite"
                                android:text="Cargando…"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Abrir, cerrar y ver movimientos"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReportesAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:id="@+id/espacioIconReportesAdmin"
                            style="@style/Widget.SmartDrop.IconChip.Anil"
                            android:layout_width="@dimen/icon_chip"
                            android:layout_height="@dimen/icon_chip"
                            android:src="@drawable/ic_reporte_vector" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Problemas reportados"
                                android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong"
                                android:textColor="@color/ink" />

                            <TextView
                                android:id="@+id/tvReportesAdminCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Responde a los residentes y cambia el estado de cada reporte"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationViewAdmin"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_admin_nav" />

</androidx.drawerlayout.widget.DrawerLayout>
