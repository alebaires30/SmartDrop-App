<?xml version="1.0" encoding="utf-8"?>
<!-- Consumo: periodo (control segmentado), total del periodo, gráfica y comparación. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    tools:context=".ConsumoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="Consumo de agua"
            android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
            android:textColor="@color/ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_7">

            <!-- Periodo: control segmentado (el activo lo marca ConsumoActivity) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segmented"
                android:orientation="horizontal"
                android:padding="@dimen/space_1">

                <TextView
                    android:id="@+id/tabDia"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Día"
                    android:textAppearance="@style/TextAppearance.SmartDrop.Label" />

                <TextView
                    android:id="@+id/tabSemana"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Semana"
                    android:textAppearance="@style/TextAppearance.SmartDrop.Label" />

                <TextView
                    android:id="@+id/tabMes"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Mes"
                    android:textAppearance="@style/TextAppearance.SmartDrop.Label" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEstadoConsumo"
                        style="@style/Widget.SmartDrop.StatusPill.None"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando…" />

                    <TextView
                        android:id="@+id/tvConsumoTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:accessibilityLiveRegion="polite"
                        android:text="0 L"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Display" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="consumidos en el periodo"
                        android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChartConsumo"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="@dimen/space_4"
                        android:contentDescription="Gráfica de consumo de agua por periodo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/Widget.SmartDrop.IconChip.Anil"
                        android:layout_width="@dimen/icon_chip"
                        android:layout_height="@dimen/icon_chip"
                        android:src="@drawable/ic_chart" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Comparación"
                            android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                            android:textColor="@color/ink_2" />

                        <TextView
                            android:id="@+id/tvComparacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="Cargando…"
                            android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavConsumo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_consumo" />

</LinearLayout>
