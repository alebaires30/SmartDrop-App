<?xml version="1.0" encoding="utf-8"?>
<!-- Burbujas de las escenas de agua: AnimacionesAgua.burbujas() las hace subir. Decorativas. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">

    <View android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_burbuja" />
    <View android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|start"
        android:layout_marginStart="88dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_burbuja" />
    <View android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp" android:background="@drawable/bg_burbuja" />
    <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|end"
        android:layout_marginEnd="96dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_burbuja" />
    <View android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="bottom|end"
        android:layout_marginEnd="36dp" android:layout_marginBottom="18dp" android:background="@drawable/bg_burbuja" />
    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="bottom|start"
        android:layout_marginStart="150dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_burbuja" />
</FrameLayout>
