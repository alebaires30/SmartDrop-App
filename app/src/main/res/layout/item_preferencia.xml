<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de interruptor del perfil: ícono, título, descripción corta y switch (toda la fila es táctil). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_2">

    <ImageView
        android:importantForAccessibility="no"
        android:id="@+id/ivPreferenciaIcono"
        style="@style/Widget.SmartDrop.IconChip.Anil"
        android:layout_width="@dimen/icon_chip"
        android:layout_height="@dimen/icon_chip" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPreferenciaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/tvPreferenciaDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchPreferencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:minHeight="@dimen/touch_min"
        app:thumbTint="@color/sd_switch_m2_thumb"
        app:trackTint="@color/sd_switch_m2_track"
        app:useMaterialThemeColors="false" />
</LinearLayout>
