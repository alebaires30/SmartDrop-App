<?xml version="1.0" encoding="utf-8"?>
<!-- Resultado de búsqueda (BusquedaAdapter): título, contenido y sección de destino. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SmartDrop.Card.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvResultTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título de la sección"
                android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tvResultContenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text=""
                android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

            <TextView
                android:id="@+id/tvResultUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text=""
                android:textAppearance="@style/TextAppearance.SmartDrop.Caption"
                android:textColor="@color/anil" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_marginStart="@dimen/space_3"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/ink_3" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
