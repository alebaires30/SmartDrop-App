<?xml version="1.0" encoding="utf-8"?>
<!-- Electroválvula: estado grande y claro, acciones con nombre (cada una pide confirmación en
     ValvulaActivity), temporizador y movimientos recientes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    tools:context=".ValvulaActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarValvula"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:navigationContentDescription="Volver"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_8">

            <!-- Estado -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado actual"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                        android:textColor="@color/ink_2" />

                    <TextView
                        android:id="@+id/tvValvulaEstadoDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:accessibilityLiveRegion="polite"
                        android:text="Cargando…"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Headline" />

                    <LinearLayout
                        android:id="@+id/layoutTemporizadorActivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="@drawable/bg_status_info"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_4"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="@dimen/space_2"
                                android:gravity="center_vertical"
                                android:text="Se cierra sola en"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Label"
                                android:textColor="@color/anil"
                                app:drawableStartCompat="@drawable/ic_timer"
                                app:drawableTint="@color/anil" />

                            <TextView
                                android:id="@+id/tvTiempoRestanteAdmin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:text="0s"
                                android:textAppearance="@style/TextAppearance.SmartDrop.Number" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelarTemporizador"
                            style="@style/Widget.SmartDrop.Button.Danger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cerrar ahora"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMensajeSoloAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Solo los administradores pueden abrir o cerrar la válvula y ver sus movimientos."
                        android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Control (solo administración) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardControlesAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutControlesAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="Control"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                        android:textColor="@color/ink" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="Cada cambio pide confirmación y queda registrado."
                        android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAbrirValvula"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            android:layout_weight="1"
                            android:text="Abrir válvula"
                            app:icon="@drawable/ic_lock_open" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCerrarValvula"
                            style="@style/Widget.SmartDrop.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:layout_weight="1"
                            android:text="Cerrar válvula"
                            app:icon="@drawable/ic_lock" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hairline"
                        android:layout_marginTop="@dimen/space_5"
                        android:background="@color/line" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Abrir por un tiempo"
                        android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong"
                        android:textColor="@color/ink" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Se cierra sola al terminar. Máximo 120 segundos."
                        android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn10s"
                            style="@style/Widget.SmartDrop.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_1"
                            android:layout_weight="1"
                            android:contentDescription="Abrir 10 segundos"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="10 s" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn30s"
                            style="@style/Widget.SmartDrop.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_1"
                            android:layout_marginEnd="@dimen/space_1"
                            android:layout_weight="1"
                            android:contentDescription="Abrir 30 segundos"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="30 s" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn60s"
                            style="@style/Widget.SmartDrop.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_1"
                            android:layout_marginEnd="@dimen/space_1"
                            android:layout_weight="1"
                            android:contentDescription="Abrir 60 segundos"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="60 s" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn120s"
                            style="@style/Widget.SmartDrop.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_1"
                            android:layout_weight="1"
                            android:contentDescription="Abrir 120 segundos"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="120 s" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPersonalizado"
                        style="@style/Widget.SmartDrop.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="Elegir otro tiempo"
                        app:icon="@drawable/ic_timer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Movimientos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogsAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="Movimientos recientes"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tvAdvertenciaLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:background="@drawable/bg_status_warn"
                        android:drawablePadding="@dimen/space_2"
                        android:gravity="center_vertical"
                        android:padding="@dimen/space_3"
                        android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall"
                        android:textColor="@color/warn"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_warning"
                        app:drawableTint="@color/warn" />

                    <TextView
                        android:id="@+id/tvLogsVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="Todavía no hay movimientos registrados."
                        android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLogsValvula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
