<?xml version="1.0" encoding="utf-8"?>
<!-- Consejo de ahorro (lo infla RecomendacionesActivity): ilustración, título, impacto y casilla. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SmartDrop.Card.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivTipImagen"
            android:layout_width="@dimen/icon_chip_lg"
            android:layout_height="@dimen/icon_chip_lg"
            android:background="@drawable/bg_icon_chip_sol"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_1"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTipTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tvTipImpacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbTip"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_2"
            android:contentDescription="Ya lo practico" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
