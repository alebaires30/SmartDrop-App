<?xml version="1.0" encoding="utf-8"?>
<!-- Vivienda en Predicción de fugas (FugasAdapter): NIC, estado (pastilla), probabilidad,
     resumen y qué hacer, con detalles plegables. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SmartDrop.Card.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFugaNic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tvFugaProbabilidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.SmartDrop.Number.Small" />

            <TextView
                android:id="@+id/tvFugaRiesgo"
                style="@style/Widget.SmartDrop.StatusPill.None"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFugaUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

        <LinearLayout
            android:id="@+id/layoutFugaInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/bg_status_bad"
            android:orientation="vertical"
            android:padding="@dimen/space_4"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFugaResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tvFugaDatosClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tvFugaAccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.SmartDrop.Body"
                android:textColor="@color/ink" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFugaNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />

        <TextView
            android:id="@+id/tvFugaVerMas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="@dimen/space_1"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:text="Ver más detalles"
            android:textAppearance="@style/TextAppearance.SmartDrop.Label"
            android:textColor="@color/anil"
            android:visibility="gone"
            app:drawableTint="@color/anil" />

        <TextView
            android:id="@+id/tvFugaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/space_3"
            android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall"
            android:textColor="@color/ink"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
