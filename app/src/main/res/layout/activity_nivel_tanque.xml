<?xml version="1.0" encoding="utf-8"?>
<!-- Tanque de tu casa: la casa con el tinaco al nivel real, litros disponibles y detalles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    tools:context=".NivelTanqueActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="Tanque de tu casa"
            android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
            android:textColor="@color/ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_7">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmartDrop.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Columna de agua en tres capas: el agua se recorta hasta el nivel real -->
                    <FrameLayout
                        android:id="@+id/columnaTanque"
                        android:layout_width="96dp"
                        android:layout_height="160dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="Tanque de tu casa">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/columna_fondo" />

                        <ImageView
                            android:id="@+id/ivColumnaAgua"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/columna_agua_nivel" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/columna_marco" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvDisponible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:accessibilityLiveRegion="polite"
                        android:text="Cargando…"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Title" />

                    <TextView
                        android:id="@+id/tvCapacidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.SmartDrop.Body"
                        android:textColor="@color/ink_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tvConversion"
                        style="@style/Widget.SmartDrop.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="Ver en barriles"
                        app:icon="@drawable/ic_refresh" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="Detalles"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tvAutonomia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:drawablePadding="@dimen/space_3"
                        android:gravity="center_vertical"
                        android:text="Autonomía estimada: calculando…"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Body"
                        app:drawableStartCompat="@drawable/ic_clock"
                        app:drawableTint="@color/anil" />

                    <TextView
                        android:id="@+id/tvBomba"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:drawablePadding="@dimen/space_3"
                        android:gravity="center_vertical"
                        android:text="Bomba: sin datos"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Body"
                        app:drawableStartCompat="@drawable/ic_power"
                        app:drawableTint="@color/agua" />

                    <TextView
                        android:id="@+id/tvUltima"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Última lectura: --:--"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_nivel" />

</LinearLayout>
