<?xml version="1.0" encoding="utf-8"?>
<!-- Movimiento de la válvula (ValvulaLogsAdapter): ícono, acción, quién y cómo, y cuándo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_3">

    <ImageView
        android:id="@+id/ivLogIcono"
        android:layout_width="@dimen/icon_chip"
        android:layout_height="@dimen/icon_chip"
        android:background="@drawable/bg_icon_chip_none"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_2"
        android:src="@drawable/ic_lock" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogAccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apertura"
            android:textAppearance="@style/TextAppearance.SmartDrop.BodyStrong" />

        <TextView
            android:id="@+id/tvLogTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:gravity="end"
        android:text=""
        android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
</LinearLayout>
