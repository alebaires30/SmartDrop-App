<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: la gota cae al agua, salen las ondas y aparece la marca. Sin fotos de fondo. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    tools:context=".SplashActivity">

    <ImageView
        android:id="@+id/fondoCompleto"
        android:layout_width="240dp"
        android:layout_height="90dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ondas_splash"
        app:layout_constraintBottom_toTopOf="@id/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <ImageView
        android:id="@+id/gota"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:importantForAccessibility="no"
        android:src="@drawable/gota"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="@dimen/space_2"
        android:alpha="0"
        android:contentDescription="SmartDrop"
        android:src="@drawable/logo_smartdrop2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fondoCompleto" />

</androidx.constraintlayout.widget.ConstraintLayout>
