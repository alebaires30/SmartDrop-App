<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F4F3FB">

    <RelativeLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="#623398">
        <ImageButton android:id="@+id/btnVolver" android:layout_width="20dp" android:layout_height="20dp"
            android:layout_centerVertical="true" android:layout_marginStart="20dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reportar problema" android:textColor="#FFFFFF" android:textStyle="bold"
            android:textSize="20sp" android:layout_centerInParent="true"/>
    </RelativeLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="¿Qué está pasando?" android:textStyle="bold" android:textSize="16sp"
                android:textColor="#3D3D3D"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Selecciona el tipo de problema más común o describe otro."
                android:textSize="13sp" android:textColor="#9A9A9A" android:layout_marginBottom="8dp"/>

            <LinearLayout android:id="@+id/layoutTipos" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_horizontal" android:layout_marginTop="4dp">
            </LinearLayout>

            <TextView android:id="@+id/tvTipoSeleccionado" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Ningún tipo seleccionado" android:textSize="13sp" android:textColor="#623398"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardCornerRadius="15dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <EditText android:id="@+id/etZona" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Zona / colonia (opcional)" android:background="@drawable/input_style"
                        android:padding="12dp" android:textSize="14sp"/>

                    <EditText android:id="@+id/etUbicacion" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Ubicación exacta (opcional)" android:background="@drawable/input_style"
                        android:padding="12dp" android:textSize="14sp" android:layout_marginTop="10dp"/>

                    <EditText android:id="@+id/etDescripcion" android:layout_width="match_parent" android:layout_height="120dp"
                        android:hint="Describe el problema con detalle (mínimo 10 caracteres)…"
                        android:background="@drawable/input_style" android:padding="12dp" android:textSize="14sp"
                        android:gravity="top" android:layout_marginTop="10dp"/>

                    <Button android:id="@+id/btnAdjuntar" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="📷 Adjuntar evidencia (foto / video)" android:textColor="#623398"
                        android:background="@drawable/fondo_redondeado" android:layout_marginTop="10dp"/>

                    <TextView android:id="@+id/tvAdjuntosSeleccionados" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:text="Sin archivos seleccionados" android:textSize="12sp" android:textColor="#9A9A9A"/>

                    <Button android:id="@+id/btnEnviarReporte" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/enviar_reporte" android:textColor="#FFFFFF"
                        android:background="@drawable/btn_gradient" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
