<?xml version="1.0" encoding="utf-8"?>
<!-- Reportar un problema: tipo de problema (tarjetas que arma ReportarProblemaActivity), detalles,
     fotos o videos y envío. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    tools:context=".ReportarProblemaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="Reportar un problema"
            android:textAppearance="@style/TextAppearance.SmartDrop.Toolbar"
            android:textColor="@color/ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_8">

            <TextView
                style="@style/Widget.SmartDrop.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuéntanos qué pasa" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Puedes agregar fotos o videos, y el equipo de SmartDrop te responderá en la app."
                android:textAppearance="@style/TextAppearance.SmartDrop.Body"
                android:textColor="@color/ink_2" />

            <TextView
                style="@style/Widget.SmartDrop.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="¿Qué tipo de problema es?" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="Elige el que más se parezca. Los detalles los escribes abajo."
                android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

            <TextView
                android:id="@+id/tvCatalogoEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:accessibilityLiveRegion="polite"
                android:text="Cargando categorías…"
                android:textAppearance="@style/TextAppearance.SmartDrop.BodySmall" />

            <LinearLayout
                android:id="@+id/layoutTipos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvTipoSeleccionado"
                style="@style/Widget.SmartDrop.StatusPill.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:accessibilityLiveRegion="polite"
                android:text=""
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="Detalles del reporte"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Subtitle"
                        android:textColor="@color/ink" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:hint="Zona o colonia (opcional)"
                        app:startIconDrawable="@drawable/ic_map_pin">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etZona"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:hint="Dirección o referencia (opcional)"
                        app:helperText="Por ejemplo: Casa 14, frente al parque.">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUbicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress|textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:hint="Describe el problema"
                        app:helperText="Desde cuándo pasa y qué tan seguido. Al menos 10 caracteres.">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdjuntar"
                        style="@style/Widget.SmartDrop.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_5"
                        android:text="Agregar fotos o videos"
                        app:icon="@drawable/ic_plus" />

                    <TextView
                        android:id="@+id/tvAdjuntosSeleccionados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:accessibilityLiveRegion="polite"
                        android:text="Sin archivos seleccionados"
                        android:textAppearance="@style/TextAppearance.SmartDrop.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarReporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/enviar_reporte"
                app:icon="@drawable/ic_send" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
