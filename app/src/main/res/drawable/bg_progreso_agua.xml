<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de nivel del tanque (tema agua): pista suave y el agua en degradado. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/agua_soft" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="@color/agua_claro"
                    android:endColor="@color/agua" />
                <corners android:radius="@dimen/radius_pill" />
            </shape>
        </clip>
    </item>
</layer-list>
