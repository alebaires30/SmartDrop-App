<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja de chat de la otra persona: surface con borde, esquina inferior izquierda más cerrada. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke android:width="@dimen/hairline" android:color="@color/line" />
    <corners
        android:bottomLeftRadius="@dimen/radius_xs"
        android:bottomRightRadius="@dimen/radius_md"
        android:topLeftRadius="@dimen/radius_md"
        android:topRightRadius="@dimen/radius_md" />
</shape>
