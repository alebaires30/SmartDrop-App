<?xml version="1.0" encoding="utf-8"?>
<!-- Botón suave (icono/texto añil encima, p. ej. Inicio en activity_inicio): anil_soft, radius_sm; presionado surface_tint + borde añil; con foco borde añil 2dp. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_tint" />
            <stroke android:width="@dimen/hairline" android:color="@color/anil" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/anil_soft" />
            <stroke android:width="2dp" android:color="@color/anil" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/anil_soft" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>
