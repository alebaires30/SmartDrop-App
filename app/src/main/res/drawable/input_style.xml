<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto: surface + borde 1dp line_strong, radius_sm. Con foco: borde añil 2dp. Deshabilitado: surface_2 + line. Trae padding 16/12dp (si el layout define padding, ese gana). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <stroke android:width="@dimen/hairline" android:color="@color/line" />
            <corners android:radius="@dimen/radius_sm" />
            <padding android:left="@dimen/space_4" android:top="@dimen/space_3"
                android:right="@dimen/space_4" android:bottom="@dimen/space_3" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="2dp" android:color="@color/anil" />
            <corners android:radius="@dimen/radius_sm" />
            <padding android:left="@dimen/space_4" android:top="@dimen/space_3"
                android:right="@dimen/space_4" android:bottom="@dimen/space_3" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/hairline" android:color="@color/line_strong" />
            <corners android:radius="@dimen/radius_sm" />
            <padding android:left="@dimen/space_4" android:top="@dimen/space_3"
                android:right="@dimen/space_4" android:bottom="@dimen/space_3" />
        </shape>
    </item>
</selector>
