<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">


    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_lavender_alt" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke_lavender" />
        </shape>
    </item>


    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/on_brand" />
            <corners android:radius="16dp" />
            <stroke
                android:width="0.5dp"
                android:color="@color/stroke_soft" />
        </shape>
    </item>

</selector>