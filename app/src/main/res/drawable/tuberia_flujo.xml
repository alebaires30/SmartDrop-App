<?xml version="1.0" encoding="utf-8"?>
<!-- Tubería del tanque a la zona con el agua avanzando (válvula abierta).
     InicioActivity la arranca con Animatable#start(); tuberia_cerrada.xml es la versión detenida. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="300dp" android:height="56dp"
            android:viewportWidth="300" android:viewportHeight="56">
            <path android:strokeColor="@color/stroke_soft" android:strokeWidth="10" android:strokeLineCap="round"
                android:pathData="M12,32H288" />
            <path android:name="flujo1" android:strokeColor="@color/agua" android:strokeWidth="4" android:strokeLineCap="round"
                android:trimPathStart="0" android:trimPathEnd="0.14" android:pathData="M12,32H288" />
            <path android:name="flujo2" android:strokeColor="@color/agua" android:strokeWidth="4" android:strokeLineCap="round"
                android:trimPathStart="0.5" android:trimPathEnd="0.64" android:pathData="M12,32H288" />
            <path android:fillColor="@color/bg_card" android:strokeColor="@color/success" android:strokeWidth="2.5"
                android:pathData="M137,18h26a9,9 0,0 1,9 9v10a9,9 0,0 1,-9 9h-26a9,9 0,0 1,-9 -9v-10a9,9 0,0 1,9 -9z" />
            <path android:strokeColor="@color/success" android:strokeWidth="2.5" android:strokeLineCap="round"
                android:pathData="M150,18V7M139,7H161" />
        </vector>
    </aapt:attr>
    <target android:name="flujo1">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathOffset" android:valueFrom="0" android:valueTo="1"
                android:duration="1800" android:repeatCount="infinite" android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="flujo2">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathOffset" android:valueFrom="0" android:valueTo="1"
                android:duration="1800" android:repeatCount="infinite" android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
