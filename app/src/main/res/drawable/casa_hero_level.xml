<?xml version="1.0" encoding="utf-8"?>
<!--
    Hero de la casa con el nivel real del tinaco.
    Capa 1: la casa (casa_hero, 240×176dp).
    Capa 2 (id casa_tank_fill): el clip del agua, colocado EXACTAMENTE sobre el interior del
    tinaco (left 100, top 18, 40×38dp) → el nivel del clip equivale al % del tanque.

    Uso:  <ImageView android:id="@+id/ivCasaHero"
              android:layout_width="@dimen/casa_hero_width"
              android:layout_height="@dimen/casa_hero_height"
              android:src="@drawable/casa_hero_level"
              android:scaleType="fitCenter" />      (cualquier scaleType menos fitXY)
          ivCasaHero.setImageLevel(porcentaje * 100);   // 0..100 → 0..10000
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/casa_hero" />
    <item
        android:id="@+id/casa_tank_fill"
        android:width="40dp"
        android:height="38dp"
        android:drawable="@drawable/casa_hero_tank_fill"
        android:left="100dp"
        android:top="18dp" />
</layer-list>
