<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de nivel redondeada para ProgressBar horizontal (el progreso se puede teñir con setProgressTintList). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_tint" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/agua" />
                <corners android:radius="@dimen/radius_pill" />
            </shape>
        </clip>
    </item>
</layer-list>
