<?xml version="1.0" encoding="utf-8"?>
<!--
    Hero "Agua en casa": casa con tinaco en el techo bajo luz de mañana.
    Lienzo 240×176 (1 unidad = 1dp). Fondo transparente: la escena sol_soft la pone la tarjeta
    (Widget.SmartDrop.Card.Hero) o el fondo bg_hero.
    El agua NO está aquí: el interior del tinaco (x 100–140, y 18–56) queda vacío (surface_2) y
    casa_hero_level.xml le superpone casa_hero_tank_fill (clip) exactamente en ese rectángulo.
    Para mostrar el nivel usa @drawable/casa_hero_level, no este archivo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="176dp"
    android:viewportWidth="240"
    android:viewportHeight="176">

    <!-- Sol de la mañana (luz cálida, decorativo): halo suave + disco -->
    <path
        android:fillAlpha="0.3"
        android:fillColor="@color/sol"
        android:pathData="M22,40a18,18 0 1,0 36,0a18,18 0 1,0 -36,0" />
    <path
        android:fillColor="@color/sol"
        android:pathData="M30,40a10,10 0 1,0 20,0a10,10 0 1,0 -20,0" />

    <!-- Suelo -->
    <path
        android:pathData="M12,164H228"
        android:strokeWidth="2"
        android:strokeColor="@color/line_strong"
        android:strokeLineCap="round" />

    <!-- Paredes -->
    <path
        android:fillColor="@color/surface"
        android:pathData="M60,98H180V164H60Z"
        android:strokeAlpha="0.3"
        android:strokeWidth="2"
        android:strokeColor="@color/ink"
        android:strokeLineJoin="round" />

    <!-- Techo (añil) -->
    <path
        android:fillColor="@color/anil"
        android:pathData="M48,100L80,74H160L192,100Z"
        android:strokeWidth="4"
        android:strokeColor="@color/anil"
        android:strokeLineJoin="round" />

    <!-- Puerta -->
    <path
        android:fillColor="@color/anil_soft"
        android:pathData="M106,164V128a4,4 0 0,1 4,-4h20a4,4 0 0,1 4,4V164Z"
        android:strokeAlpha="0.3"
        android:strokeWidth="2"
        android:strokeColor="@color/ink"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="@color/anil"
        android:pathData="M126.2,146a1.8,1.8 0 1,0 3.6,0a1.8,1.8 0 1,0 -3.6,0" />

    <!-- Ventanas con luz (sol) -->
    <path
        android:fillColor="@color/sol"
        android:pathData="M72,112h24v20h-24z"
        android:strokeAlpha="0.3"
        android:strokeWidth="2"
        android:strokeColor="@color/ink"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="@color/sol"
        android:pathData="M144,112h24v20h-24z"
        android:strokeAlpha="0.3"
        android:strokeWidth="2"
        android:strokeColor="@color/ink"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M84,112v20M72,122h24M156,112v20M144,122h24"
        android:strokeAlpha="0.3"
        android:strokeWidth="1.5"
        android:strokeColor="@color/ink" />

    <!-- Base del tinaco -->
    <path
        android:pathData="M104,74V62M136,74V62M98,62H142"
        android:strokeWidth="4"
        android:strokeColor="@color/line_strong"
        android:strokeLineCap="round" />

    <!-- Cuerpo del tinaco -->
    <path
        android:fillColor="@color/surface"
        android:pathData="M104,14H136a8,8 0 0,1 8,8V52a8,8 0 0,1 -8,8H104a8,8 0 0,1 -8,-8V22a8,8 0 0,1 8,-8Z"
        android:strokeWidth="3"
        android:strokeColor="@color/line_strong"
        android:strokeLineJoin="round" />

    <!-- Interior vacío del tinaco (x 100–140, y 18–56): aquí se dibuja el agua -->
    <path
        android:fillColor="@color/surface_2"
        android:pathData="M105,18H135a5,5 0 0,1 5,5V51a5,5 0 0,1 -5,5H105a5,5 0 0,1 -5,-5V23a5,5 0 0,1 5,-5Z" />

    <!-- Tapa -->
    <path
        android:fillColor="@color/line_strong"
        android:pathData="M112,14V10a2,2 0 0,1 2,-2h12a2,2 0 0,1 2,2V14Z" />

    <!-- Marcas de nivel 25 / 50 / 75 % (a la derecha del tinaco) -->
    <path
        android:pathData="M148,46.5h4M148,37h6M148,27.5h4"
        android:strokeWidth="1.5"
        android:strokeColor="@color/line_strong"
        android:strokeLineCap="round" />
</vector>
