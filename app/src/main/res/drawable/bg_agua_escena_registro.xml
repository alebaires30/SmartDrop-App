<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del registro: color liso detrás de la escena y el degradado de agua debajo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/agua_grad_inicio" />
    </item>
    <item android:top="240dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/agua_grad_inicio"
                android:centerColor="@color/agua_grad_medio"
                android:endColor="@color/agua_grad_fin" />
        </shape>
    </item>
</layer-list>
