<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+: la sesión (tokens JWT en sesion.xml) nunca sale del teléfono, ni en la copia en la nube
   ni al pasar los datos a otro teléfono. Además allowBackup="false" en el manifiesto.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesion.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesion.xml" />
    </device-transfer>
</data-extraction-rules>
