<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de copia de seguridad para Android 12 o superior.
   La transferencia entre teléfonos se hace aunque allowBackup sea "false",
   por eso la sesión (tokens de acceso en sesion.xml) se excluye de ambas: nunca sale
   del teléfono, ni en la copia en la nube ni al pasar los datos a otro teléfono.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesion.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesion.xml" />
    </device-transfer>
</data-extraction-rules>
