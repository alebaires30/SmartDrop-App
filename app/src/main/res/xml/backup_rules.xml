<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de copia de seguridad para Android 11 o anterior.
   La app tiene allowBackup="false"; aun así la sesión (tokens de acceso en sesion.xml)
   se excluye por si algún día se vuelve a activar la copia.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sesion.xml" />
</full-backup-content>
