<?xml version="1.0" encoding="utf-8"?>
<!-- Borde de un tile tocable (Widget.SmartDrop.Card.Tile): añil al presionar o con foco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/anil" android:state_pressed="true" />
    <item android:color="@color/anil" android:state_focused="true" />
    <item android:color="@color/anil" android:state_checked="true" />
    <item android:color="@color/line" />
</selector>
