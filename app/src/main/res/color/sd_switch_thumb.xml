<?xml version="1.0" encoding="utf-8"?>
<!-- Botón del interruptor: on_anil encendido, ink_3 apagado (contraste ≥ 3:1 sobre la pista). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/surface" android:state_enabled="false" android:state_checked="true" />
    <item android:alpha="0.38" android:color="@color/ink_3" android:state_enabled="false" />
    <item android:color="@color/on_anil" android:state_checked="true" />
    <item android:color="@color/ink_3" />
</selector>
