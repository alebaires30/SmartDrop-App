<?xml version="1.0" encoding="utf-8"?>
<!-- Borde de los campos (TextInputLayout): añil con foco, line_strong en reposo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/line" android:state_enabled="false" />
    <item android:color="@color/anil" android:state_focused="true" />
    <item android:color="@color/ink_2" android:state_hovered="true" />
    <item android:color="@color/line_strong" />
</selector>
